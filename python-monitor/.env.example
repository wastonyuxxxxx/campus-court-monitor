# Optional iCloud Mail SMTP notifications.
# Uncomment and fill in the following lines to enable email alerts.
# Use an Apple app-specific password.
# SMTP_HOST=smtp.mail.me.com
# SMTP_PORT=587
# SMTP_USERNAME=your-icloud-address@icloud.com
# SMTP_PASSWORD=your-app-specific-password
# SMTP_FROM=your-icloud-address@icloud.com
# SMTP_TO=your-icloud-address@icloud.com
