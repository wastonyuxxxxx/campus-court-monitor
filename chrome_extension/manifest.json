{
  "manifest_version": 3,
  "name": "网球场地空场提醒",
  "version": "1.0.0",
  "description": "只读检查网球场周历，有空场时发送本机通知。",
  "permissions": ["alarms", "notifications", "storage"],
  "host_permissions": [
    "https://booking.fudan.edu.cn/reservation/fe/site/reservationInfo*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "网球场地空场提醒",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://booking.fudan.edu.cn/reservation/fe/site/reservationInfo*"
      ],
      "js": ["config.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
